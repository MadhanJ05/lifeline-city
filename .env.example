# Lifeline City environment template.
# Copy to .env (git-ignored) and fill in locally. Never commit real secrets or phone numbers.

# LLM briefings key. Leave empty to run the pipeline without the LLM step.
ANTHROPIC_API_KEY=
# AWS region for the LLM client, if used (e.g. us-east-1).
AWS_REGION=
# US Census API key for ACS pulls.
CENSUS_API_KEY=

# simulator | twilio. Unset or any other value means simulator.
SMS_MODE=
# Twilio credentials, only used when SMS_MODE=twilio and the Twilio block is built.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated E.164 numbers, assigned to synthetic household #1..n in order.
DEMO_PHONE_NUMBERS=
# Seconds before an unanswered check-in is marked silent. Defaults to 30 when unset.
DEMO_REPLY_TIMEOUT_SECONDS=
